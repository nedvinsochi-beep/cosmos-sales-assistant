# Copy to .env locally. Never commit the real URL: it contains the access token.
BITRIX_WEBHOOK_URL=https://your-portal.bitrix24.ru/rest/user-id/webhook-token/
BITRIX_TIMEOUT_SECONDS=30
BITRIX_RATE_LIMIT_PER_SECOND=2
BITRIX_MAX_RETRIES=3
BITRIX_MASK_PERSONAL_DATA=true
BITRIX_RULES_CONFIG=config/audit-rules.example.json
