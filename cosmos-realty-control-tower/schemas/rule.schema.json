{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cosmos-realty.local/schemas/rule.schema.json",
  "title": "Cosmos Control Rule",
  "type": "object",
  "required": [
    "rule_id", "name", "description", "enabled", "mode", "schedule", "timezone",
    "entity_type", "scope", "conditions", "exclusions", "deadline", "violation",
    "actions", "escalation", "kpi", "idempotency_key", "owner", "version"
  ],
  "properties": {
    "rule_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "enabled": {"type": "boolean"},
    "mode": {"enum": ["OFF", "DRY_RUN", "APPROVAL_REQUIRED", "ACTIVE"]},
    "schedule": {"type": "string", "minLength": 1},
    "timezone": {"type": "string", "minLength": 1},
    "entity_type": {"type": "string", "minLength": 1},
    "scope": {"type": "object"},
    "conditions": {"type": "array", "items": {"type": "object"}},
    "exclusions": {"type": "array", "items": {"type": "object"}},
    "deadline": {"type": "object"},
    "violation": {"type": "object"},
    "actions": {"type": "array", "items": {"type": "object"}},
    "escalation": {"type": "array", "items": {"type": "object"}},
    "kpi": {"type": "array", "items": {"type": "string"}},
    "idempotency_key": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "evaluator": {"type": "string", "default": "simple_conditions"}
  },
  "additionalProperties": false
}
